{
  "name": "@jev-game/server",
  "version": "0.1.0",
  "private": true,
  "description": "The Colyseus multiplayer server. Server-only — the browser client lives in apps/client.",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "mocha --import tsx \"test/**/*.test.ts\" --timeout 15000",
    "loadtest": "tsx loadtest/example.ts --room arena --numClients 2"
  },
  "dependencies": {
    "@colyseus/playground": "^0.18.3",
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "@jev-game/colyseus-contract": "workspace:*",
    "@jev-game/shared": "workspace:*",
    "colyseus": "^0.18.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.13.13",
    "esbuild": "^0.28.2",
    "mocha": "^11.7.5",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">= 22.0.0"
  }
}
