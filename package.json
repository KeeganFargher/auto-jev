{
  "name": "jev-game",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:client": "pnpm --filter ./apps/client dev",
    "dev:server": "pnpm --filter ./apps/server dev",
    "dev": "pnpm -r --if-present build && pnpm -r --parallel --if-present dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "lint": "NODE_OPTIONS=--import=tsx oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "simulate": "tsx scripts/simulate.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "audio:check": "tsx scripts/audio/check.ts",
    "models:import": "tsx scripts/models/import.ts",
    "models:check": "tsx scripts/models/check.ts"
  },
  "devDependencies": {
    "@jev-game/content": "workspace:*",
    "@jev-game/game": "workspace:*",
    "@jev-game/run": "workspace:*",
    "@oxlint/plugins": "1.83.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.15"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1"
}
