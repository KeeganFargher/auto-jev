{
  "name": "@jev-game/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "sim-hash": "tsx ../../scripts/sim-hash.ts",
    "build": "tsx ../../scripts/sim-hash.ts && tsc -p tsconfig.json",
    "dev": "tsx ../../scripts/sim-hash.ts && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsx ../../scripts/sim-hash.ts && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jev-game/run": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
