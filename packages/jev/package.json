{
  "name": "@jev-game/jev",
  "version": "0.0.0",
  "private": true,
  "description": "Jev players: the TypeSafe provider, observations, decisions and decision records. Server-only; never import it from apps/client.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "probe": "pnpm --filter \"@jev-game/jev^...\" --if-present build && tsx src/probe.ts"
  },
  "dependencies": {
    "@jev-game/content": "workspace:*",
    "@jev-game/game": "workspace:*",
    "@jev-game/run": "workspace:*",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
